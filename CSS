/* Reset básico global (Zera margens e paddings padrões) */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* Configuração geral do corpo da página com Flexbox */
body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #f5f2f2;
    font-family: sans-serif; /* Altera para uma fonte mais moderna e limpa */
}

/* Estilização do Cabeçalho */
.cabecalho {
    background-color: #7e3e1c;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

h1 {
    color: #fff;
    font-size: 24px;
}

.cabecalho-link {
    color: #fff;
    text-decoration: none;
}

/* Estilização do Conteúdo Principal */
main {
    flex: 1;
    padding: 30px; /* Adiciona espaçamento interno para afastar das bordas */
}

main h2 {
    margin-bottom: 25px;
}

/* Alinhamento dos cards na horizontal */
.cartoes {
    display: flex;
    gap: 16px;
    flex-wrap: wrap; /* Faz os cards irem para baixo se faltar espaço na tela */
}

/* Estrutura 3D do Flashcard */
.cartao {
    width: 260px;
    height: 320px; /* Ajustado para acomodar imagem e texto confortavelmente */
    perspective: 1000px; /* Ativa a sensação de profundidade no efeito 3D */
}

.cartao-interno {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s;
    transform-style: preserve-3d;
}

/* Dispara a rotação de 180 graus quando o mouse passa por cima do card */
.cartao:hover .cartao-interno {
    transform: rotateY(180deg);
}

/* Configuração comum de posicionamento para a Frente e Verso */
.cartao-frente, .cartao-verso {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 12px;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    backface-visibility: hidden; /* Esconde o conteúdo de trás enquanto vira */
    background-color: #fff;
    padding: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: space-between;
}

/* Configuração específica do Verso */
.cartao-verso {
    transform: rotateY(180deg); /* Começa invertido para girar no sentido certo */
}

/* Imagens aplicadas nos cartões */
.cartao-imagem {
    width: 100%;
    height: 150px;
    object-fit: cover; /* Recorta a imagem proporcionalmente sem distorcer */
    border-radius: 8px;
}

/* Estilização do Rodapé */
footer {
    background-color: #7e3e1c;
    padding: 15px 25px;
    color: #fff;
    text-align: center;
}
