<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Flashcards de Mitos e Verdades</title>
    <!-- Conecta o HTML ao arquivo de estilos CSS externo -->
    <link rel="stylesheet" href="estilos.css" />
</head>
<body>

    <!-- Cabeçalho do site -->
    <header class="cabecalho">
        <h1>Confere Aí</h1>
        <nav>
            <a href="#" class="cabecalho-link">Início</a>
        </nav>
    </header>

    <!-- Conteúdo principal da página -->
    <main>
        <h2>Descubra a verdade passando o mouse</h2>
        
        <!-- Seção que agrupa todos os flashcards -->
        <section class="cartoes">
            
            <!-- CARD 1: Sobre os Pinguins -->
            <article class="cartao">
                <div class="cartao-interno">
                    <!-- Frente do Card 1 -->
                    <div class="cartao-frente">
                        <img src="https://nationalgeographicbrasil.com" alt="Pinguim imperador" class="cartao-imagem" />
                        <p>Pinguins conseguem voar como pássaros!</p>
                    </div>
                    <!-- Verso do Card 1 -->
                    <div class="cartao-verso">
                        <img src="https://nationalgeographicbrasil.com" alt="Pinguim imperador" class="cartao-imagem" />
                        <p>Pinguins não voam, mas são excelentes nadadores.</p>
                    </div>
                </div>
            </article>

            <!-- CARD 2: Sobre Fake News (Duplicado conforme Aula 08) -->
            <article class="cartao">
                <div class="cartao-interno">
                    <!-- Frente do Card 2 -->
                    <div class="cartao-frente">
                        <img src="https://nationalgeographicbrasil.com" alt="Pinguim imperador" class="cartao-imagem" />
                        <p>Gargarejo com água morna cura COVID-19!</p>
                    </div>
                    <!-- Verso do Card 2 -->
                    <div class="cartao-verso">
                        <img src="https://nationalgeographicbrasil.com" alt="Pinguim imperador" class="cartao-imagem" />
                        <p>Isso é fake news. Não há comprovação científica e coloca a saúde em risco.</p>
                    </div>
                </div>
            </article>

        </section>
    </main>

    <!-- Rodapé da página -->
    <footer>
        <p>Projeto feito por [Seu Nome]</p>
    </footer>

</body>
</html>
